:description: This script emulates the Bitcraze Crazyflie 2.1 platform and runs the Crazyflie firmware.
:Original source: https://github.com/bitcraze/renode/tree/crazyflie
:path: /renode/scripts/single-node/crazyflie.resc

logFile @logs/renode.log true 
logLevel 2 file 
logLevel 3 console


include @custom-renode-assets/STM32F4_I2C.cs 
include @custom-renode-assets/STM32_Basic_Timer.cs 
include @custom-renode-assets/EEPROM_24AA64.cs 
include @custom-renode-assets/CF_Syslink.cs 
include @custom-renode-assets/BMI088_Gyroscope.cs 
include @custom-renode-assets/BMI088_Accelerometer.cs 
include @custom-renode-assets/BMP388.cs 


mach create "CF2.1"
machine LoadPlatformDescription @cf2.repl 
emulation SetAdvanceImmediately true
emulation SetGlobalQuantum "0.0001"

# Should be written during production
sysbus.otp WriteString 0x7800 "0;CF21"


# Uncomment/comment to toggle open Analyzer windows
showAnalyzer sysbus.usart3
# showAnalyzer sysbus.usart6
# showAnalyzer sysbus.nrf

sysbus LoadELF @cf2.elf

emulation CreateUARTHub "syslink"
connector Connect sysbus.usart6 syslink
connector Connect sysbus.nrf syslink
syslink Start

machine StartGdbServer 3333
emulation CreateServerSocketTerminal 3456 "sensors"
connector Connect sysbus.i2c3.bmi_gyro sensors

emulation CreateServerSocketTerminal 3457 "nRF" false 
connector Connect sysbus.usart6 nRF

# Uncomment/comment to toggle noisy LEDs logLevel
# logLevel -1 console sysbus.gpioPortD.ledB
# logLevel -1 console sysbus.gpioPortC.ledRL
# logLevel -1 console sysbus.gpioPortC.ledGL
# logLevel -1 console sysbus.gpioPortC.ledGR
# logLevel -1 console sysbus.gpioPortC.ledRR

# Uncomment/comment to toggle how much information the sensors log
# logLevel -1 console sysbus.i2c3.bmi_gyro
# logLevel -1 console sysbus.i2c3.bmi_accel
# logLevel -1 console sysbus.i2c3.bmp_baro

# logLevel -1 file sysbus.i2c3 
# logLevel -1 file sysbus.dma1 
# logLevel -1 file sysbus.i2c3.bmi_gyro 
# logLevel -1 file sysbus.usart6

# Data samples required to pass initialization and test
sysbus.i2c3.bmi_gyro FeedGyroSamplesLooped @data/gyro_values.txt 1000

# sysbus LogPeripheralAccess sysbus.i2c3
# sysbus LogAllPeripheralsAccess true
# sysbus.cpu LogFunctionNames true

# sysbus.usart3 AddLineHook "" "Antmicro.Renode.Logging.Logger.Log(LogLevel.Error, line)"
# sysbus.usart3 AddLineHook "Free heap" "Antmicro.Renode.Emulator.Exit()"

emulation RunFor "10"
sysbus.i2c3 LowerImmediately true
